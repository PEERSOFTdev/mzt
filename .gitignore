# Build tree (created by the top-level Makefile / CMake)
build/

# Third-party reference material, not part of MZT and not redistributable:
# Cameron W. Cotrill's 1988 "Z80 and 64180 Assembly Language Help Guide",
# (c)1988 All Rights Reserved. Kept locally as a reference only.
Z80HELP/
Z80HELP.LBR

